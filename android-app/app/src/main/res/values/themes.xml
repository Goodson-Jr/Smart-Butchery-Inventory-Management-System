<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SBIMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_deep</item>
        <item name="colorPrimaryDark">@color/dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="materialButtonStyle">@style/Widget.SBIMS.Button</item>
        <item name="textInputStyle">@style/Widget.SBIMS.TextInputLayout</item>
    </style>

    <style name="Widget.SBIMS.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_deep</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.SBIMS.Button.Dark">
        <item name="backgroundTint">@color/dark</item>
    </style>

    <style name="Widget.SBIMS.Button.Soft" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/yellow</item>
        <item name="android:textColor">@color/brand_deep</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.SBIMS.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="hintTextColor">@color/ink_soft</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <style name="Text.Muted">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Card.Elevated">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">4dp</item>
    </style>
</resources>
